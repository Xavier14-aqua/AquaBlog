---
// Without JavaScript the original Markdown remains fully readable.
---
<div class="journal-cards" data-journal-cards>
  <div class="journal-cards-track" data-card-track><slot /></div>
  <div class="journal-cards-controls" data-card-controls hidden>
    <button type="button" data-card-prev aria-label="上一份感谢">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
    <span data-card-status role="status" aria-live="polite" aria-atomic="true"></span>
    <button type="button" data-card-next aria-label="下一份感谢">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
    <span class="journal-cards-hint">左右滑动切换</span>
  </div>
</div>

<style is:global>
  .journal-cards [hidden] { display: none !important; }
  .journal-cards.is-ready .journal-cards-track {
    display: flex; align-items: flex-start; gap: 0;
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain; scrollbar-width: thin;
  }
  .journal-cards-slide {
    flex: 0 0 100%; min-width: 0; box-sizing: border-box;
    scroll-snap-align: start; scroll-snap-stop: always;
    padding: 1.25rem; background: #1a4bff05;
    border: 1px solid #1a4bff20; border-radius: 12px;
    overflow-wrap: anywhere;
  }
  .journal-cards-slide > p { margin: 0 0 1rem; white-space: pre-line; }
  .journal-cards-slide > :last-child { margin-bottom: 0; }
  .journal-cards-controls {
    display: flex; align-items: center; flex-wrap: wrap; gap: .75rem;
    margin-top: 1rem; color: var(--color-klein); font-size: .875rem;
    line-height: 1.5; white-space: normal;
  }
  .journal-cards-controls button {
    display: grid; place-items: center; width: 44px; height: 44px;
    border: 1px solid #1a4bff40; border-radius: 50%; cursor: pointer;
    transition: background-color .2s, color .2s;
  }
  .journal-cards-controls button:hover:not(:disabled) { background: var(--color-klein); color: white; }
  .journal-cards-controls button:disabled { opacity: .3; cursor: default; }
  .journal-cards-hint { margin-left: auto; color: var(--color-muted); font-size: .8125rem; }
</style>

<script>
  let disposers: Array<() => void> = [];
  function cleanupCards() {
    disposers.forEach(dispose => dispose());
    disposers = [];
  }
  function initCards() {
    cleanupCards();
    document.querySelectorAll<HTMLElement>('[data-journal-cards]').forEach(root => {
      const track = root.querySelector<HTMLElement>('[data-card-track]')!;
      const controls = root.querySelector<HTMLElement>('[data-card-controls]')!;
      const previous = root.querySelector<HTMLButtonElement>('[data-card-prev]')!;
      const next = root.querySelector<HTMLButtonElement>('[data-card-next]')!;
      const status = root.querySelector<HTMLElement>('[data-card-status]')!;
      if (!root.classList.contains('is-ready')) {
        const groups: Node[][] = [[]];
        for (const node of Array.from(track.childNodes)) {
          if (node instanceof HTMLHRElement) groups.push([]);
          else groups[groups.length - 1].push(node);
        }
        const entries = groups.filter(group => group.some(node => node.textContent?.trim()));
        if (entries.length < 2) return;
        const slides = entries.map((nodes, i) => {
          const slide = document.createElement('div');
          slide.className = 'journal-cards-slide';
          slide.setAttribute('role', 'group');
          slide.setAttribute('aria-label', `第 ${i + 1} 份感谢，共 ${entries.length} 份`);
          slide.append(...nodes);
          return slide;
        });
        track.replaceChildren(...slides);
        root.classList.add('is-ready');
      }
      const slides = Array.from(track.children) as HTMLElement[];
      track.tabIndex = 0;
      track.setAttribute('role', 'region');
      track.setAttribute('aria-label', '感谢卡片，使用左右方向键切换');
      track.setAttribute('data-lenis-prevent', '');
      controls.hidden = false;
      const abort = new AbortController();
      const options = { signal: abort.signal };
      let frame = 0;
      const index = () => Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / (track.clientWidth || 1))));
      const update = () => {
        const current = index();
        const label = `${current + 1} / ${slides.length}`;
        if (status.textContent !== label) status.textContent = label;
        previous.disabled = current === 0;
        next.disabled = current === slides.length - 1;
        const scrollbar = track.offsetHeight - track.clientHeight;
        const height = `${slides[current].offsetHeight + scrollbar}px`;
        if (track.style.height !== height) track.style.height = height;
      };
      const go = (step: number) => {
        const target = Math.max(0, Math.min(slides.length - 1, index() + step));
        track.scrollTo({ left: target * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      };
      previous.addEventListener('click', () => go(-1), options);
      next.addEventListener('click', () => go(1), options);
      track.addEventListener('keydown', event => {
        if (event.target !== track || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
        event.preventDefault(); go(event.key === 'ArrowLeft' ? -1 : 1);
      }, options);
      track.addEventListener('scroll', () => {
        if (frame) return;
        frame = requestAnimationFrame(() => { frame = 0; update(); });
      }, { ...options, passive: true });
      let lastWidth = track.clientWidth;
      const resize = new ResizeObserver(() => {
        if (track.clientWidth !== lastWidth) {
          const selected = Number(status.textContent?.split('/')[0]) - 1 || 0;
          lastWidth = track.clientWidth;
          track.scrollTo({ left: selected * lastWidth, behavior: 'instant' });
        }
        update();
      });
      slides.forEach(slide => resize.observe(slide));
      update();
      disposers.push(() => { abort.abort(); resize.disconnect(); cancelAnimationFrame(frame); });
    });
  }
  document.addEventListener('astro:page-load', initCards);
  document.addEventListener('astro:before-swap', cleanupCards);
</script>
