---
import { getCollection } from 'astro:content';
import { entryUrl, formatDate } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allItems = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const projectList = allItems.filter((item) => item.data.kind === 'project');
const noteList = allItems.filter((item) => item.data.kind === 'note');

const statusLabel = {
  active: { text: 'ITERATING', cls: 'bg-klein text-white' },
  completed: { text: 'COMPLETED', cls: 'bg-ink text-white' },
  prototype: { text: 'PROTOTYPE', cls: 'border border-ink/30 text-ink' },
};
---

<BaseLayout title="技术与项目 // Aqua">
  <main id="main-content" class="mx-auto max-w-6xl px-6 pb-28 pt-12">
    <!-- 页头 -->
    <header class="border-b border-ink pb-6">
      <p class="font-mono text-xs tracking-[0.22em] text-klein">01 // PROJECTS &amp; ENGINEERING</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h1 class="text-4xl font-bold tracking-tight">技术与项目</h1>
        <p class="font-mono text-xs text-muted">
          {projectList.length} PROJECTS · {noteList.length} NOTES
        </p>
      </div>
    </header>

    <!-- 上半轨：项目展示墙 -->
    <section class="mt-10">
      <div class="mb-5 flex items-center justify-between font-mono text-[11px] tracking-[0.2em] text-muted">
        <span>TRACK A // SHIPPED &amp; OPEN-SOURCE</span>
        <span>CLICK REPO TO INSPECT</span>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          projectList.map((entry, idx) => {
            const st = statusLabel[entry.data.status];
            return (
              <article class="group relative flex flex-col justify-between border border-ink/15 bg-white/70 p-6 transition-all duration-200 hover:border-klein hover:shadow-[0_18px_40px_-24px_rgba(26,75,255,0.35)]">
                <!-- 右上角制图角标 -->
                <span class="pointer-events-none absolute right-0 top-0 h-3 w-3 border-r-2 border-t-2 border-klein opacity-0 transition-opacity group-hover:opacity-100" />

                <div>
                  <div class="flex items-center justify-between gap-3 font-mono text-[11px]">
                    <span class="text-muted">PRJ.0{idx + 1}</span>
                    <span class={`px-2 py-0.5 tracking-widest ${st.cls}`}>{st.text}</span>
                  </div>

                  <h2 class="mt-3 text-xl font-bold tracking-tight text-ink group-hover:text-klein transition-colors">
                    <a href={entryUrl('projects', entry.id)}>{entry.data.title}</a>
                  </h2>

                  <p class="mt-2.5 text-sm leading-7 text-muted">{entry.data.summary}</p>

                  {entry.data.highlights.length > 0 && (
                    <ul class="mt-4 space-y-2 border-t border-dashed border-ink/15 pt-4 text-[13px] leading-6 text-ink/85">
                      {entry.data.highlights.map((point) => (
                        <li class="flex gap-2.5">
                          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-klein" />
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-ink/10 pt-4">
                  <div class="flex flex-wrap gap-1.5">
                    {entry.data.stack.map((tech) => (
                      <span class="border border-ink/15 bg-paper px-2 py-0.5 font-mono text-[11px] text-ink/80">
                        {tech}
                      </span>
                    ))}
                  </div>

                  {entry.data.repoUrl && (
                    <a
                      href={entry.data.repoUrl}
                      target="_blank"
                      rel="noreferrer"
                      class="font-mono text-xs font-medium text-klein hover:underline"
                    >
                      GITHUB ↗
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- 下半轨：技术文章与复盘笔记 -->
    <section class="mt-20">
      <div class="mb-4 flex items-end justify-between border-b border-ink pb-3">
        <div>
          <p class="font-mono text-[11px] tracking-[0.2em] text-klein">TRACK B // TECHNICAL NOTES</p>
          <h2 class="mt-1 text-2xl font-bold tracking-tight">技术复盘与笔记</h2>
        </div>
      </div>

      {
        noteList.length > 0 ? (
          <div class="divide-y divide-ink/15 border-b border-ink/15">
            {noteList.map((note) => (
              <a href={entryUrl('projects', note.id)} class="group grid grid-cols-12 items-center gap-3 px-3 py-4 transition-colors duration-150 hover:bg-klein hover:text-white">
                <span class="col-span-3 font-mono text-xs text-muted group-hover:text-white/80 sm:col-span-2">
                  {formatDate(note.data.pubDate)}
                </span>
                <span class="col-span-9 text-[15px] font-medium sm:col-span-8">{note.data.title}</span>
                <span class="hidden text-right font-mono text-xs text-muted group-hover:text-white sm:col-span-2 sm:block">
                  {note.data.stack[0] ?? 'NOTE'}
                </span>
              </a>
            ))}
          </div>
        ) : (
          <div class="border border-dashed border-ink/20 bg-white/40 px-6 py-10 text-center font-mono text-xs text-muted">
            技术复盘与笔记整理中。
          </div>
        )
      }
    </section>
  </main>
</BaseLayout>
