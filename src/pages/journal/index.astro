---
import { getCollection, render } from 'astro:content';
import { entryUrl, formatDate as fmtDate } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JournalCards from '../../components/JournalCards.astro';

const allJournal = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fragments = await Promise.all(
  allJournal
    .filter((e) => e.data.entryType === 'fragment')
    .map(async (entry) => ({ entry, rendered: await render(entry) }))
);

const essays = allJournal.filter((e) => e.data.entryType === 'essay');

---

<BaseLayout title="生活日记 // Aqua">
  <main id="main-content" class="mx-auto max-w-6xl px-6 pb-28 pt-12">
    <header class="border-b border-ink pb-6">
      <p class="font-mono text-xs tracking-[0.22em] text-klein">03 // JOURNAL &amp; FRAGMENTS</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <h1 class="text-4xl font-bold tracking-tight">生活日记</h1>
        <p class="font-mono text-xs text-muted">DUAL MODE // TIMELINE + ESSAYS</p>
      </div>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12">
      <!-- 左栏：碎片时间轴 -->
      <section class="lg:col-span-7">
        <p class="mb-6 font-mono text-[11px] tracking-[0.2em] text-muted">
          MODE A // FRAGMENT TIMELINE
        </p>

        <div class="relative space-y-8 border-l border-ink/20 pl-6">
          {
            fragments.map(({ entry, rendered }) => {
              const { Content } = rendered;
              return (
                <article class="relative border border-ink/12 bg-white/75 p-6">
                  <!-- 时间轴克莱因蓝圆点 -->
                  <span class="absolute -left-[30px] top-6 h-2.5 w-2.5 rounded-full border-2 border-paper bg-klein" />

                  <!-- 制图风元数据条：日期 · 天气 · BGM -->
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-dashed border-ink/15 pb-3 font-mono text-[11px] tracking-wider text-muted">
                    <span class="font-semibold text-klein">{fmtDate(entry.data.pubDate)}</span>
                    {entry.data.weather && <span>· {entry.data.weather}</span>}
                    {entry.data.bgm && <span>· ♪ {entry.data.bgm}</span>}
                  </div>

                  <h2 class="mt-4 text-base font-bold text-ink"><a href={entryUrl('journal', entry.id)}>{entry.data.title}</a></h2>

                  <div class="mt-3 whitespace-pre-line text-[14.5px] leading-8 text-ink/85 [&>p]:mb-3 [&>p:last-child]:mb-0">
                    {entry.data.carousel ? <JournalCards><Content /></JournalCards> : <Content />}
                  </div>
                </article>
              );
            })
          }
        </div>
      </section>

      <!-- 右栏：长日记归档 -->
      <aside class="lg:col-span-5">
        <p class="mb-6 font-mono text-[11px] tracking-[0.2em] text-muted">
          MODE B // LONG ESSAYS
        </p>

        {
          essays.length > 0 ? (
            <div class="divide-y divide-ink/15 border-y border-ink/15">
              {essays.map((entry) => (
                <a href={entryUrl('journal', entry.id)} class="group block py-4 transition-colors hover:bg-klein hover:px-3 hover:text-white">
                  <div class="font-mono text-[11px] text-muted group-hover:text-white/75">
                    {fmtDate(entry.data.pubDate)}
                    {entry.data.weather && ` · ${entry.data.weather}`}
                  </div>
                  <h3 class="mt-1 font-medium">{entry.data.title}</h3>
                </a>
              ))}
            </div>
          ) : (
            <div class="border border-dashed border-ink/20 bg-white/40 p-6 font-mono text-xs leading-6 text-muted">
              先记录日常碎片，长篇日记慢慢写。
            </div>
          )
        }
      </aside>
    </div>
  </main>
</BaseLayout>
